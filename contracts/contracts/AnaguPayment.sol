pragma solidity ^0.8.24;

import {AccessControl} from "@openzeppelin/contracts/access/AccessControl.sol";
import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import {ECDSA} from "@openzeppelin/contracts/utils/cryptography/ECDSA.sol";
import {MessageHashUtils} from "@openzeppelin/contracts/utils/cryptography/MessageHashUtils.sol";

/**
 * @title AnaguPayment
 * @notice Native ETH registration fee payment contract for the Anagu Land Administration Platform.
 * @dev Scope & Security Invariants:
 *   - Collects ONLY land registration fees in native ETH via payable functions.
 *   - Payment NEVER grants land ownership, title approval, or NFT issuance.
 *   - Prevents duplicate payments per unique registration reference.
 *   - Supports configurable fee quotes (backend ECDSA-signed expiring quotes or admin-configured fees).
 *   - Enforces Pausable emergency stop, ReentrancyGuard, and role-restricted treasury withdrawals.
 */
contract AnaguPayment is AccessControl, Pausable, ReentrancyGuard {
    using ECDSA for bytes32;
    using MessageHashUtils for bytes32;

    bytes32 public constant FEE_ADMIN_ROLE = keccak256("FEE_ADMIN_ROLE");
    bytes32 public constant TREASURY_ROLE = keccak256("TREASURY_ROLE");
    bytes32 public constant PAUSER_ROLE = keccak256("PAUSER_ROLE");

    struct PaymentRecord {
        string registrationReference;
        bytes32 quoteId;
        address payer;
        uint256 amountWei;
        uint256 paidAt;
        bool paid;
    }

    /// @notice Configurable fallback fee in wei (never hardcoded to an invented statutory NGN fee).
    uint256 public configurableFeeWei;

    /// @notice Optional off-chain quote signer address authorized to sign NGN->ETH expiring quotes.
    address public quoteSigner;

    /// @notice Tracks per-registration payment records keyed by keccak256(bytes(registrationReference)).
    mapping(bytes32 => PaymentRecord) private _paymentsByRefHash;

    /// @notice Optional on-chain quoted fees keyed by registration reference hash.
    mapping(bytes32 => uint256) public quotedFeeWeiByRefHash;

    /// @notice Prevents replay of signed off-chain payment quotes.
    mapping(bytes32 => bool) public usedQuoteIds;

    /// @notice Ordered list of paid registration reference hashes for audit enumeration.
    bytes32[] private _paidRefHashes;

    event PaymentReceived(
        bytes32 indexed regRefHash,
        string registrationReference,
        bytes32 indexed quoteId,
        address indexed payer,
        uint256 amountWei,
        uint256 paidAt
    );

    event ConfigurableFeeUpdated(uint256 previousFeeWei, uint256 newFeeWei, address indexed updatedBy);
    event RegistrationFeeQuoted(
        bytes32 indexed regRefHash,
        string registrationReference,
        uint256 requiredAmountWei,
        address indexed quotedBy
    );
    event QuoteSignerUpdated(address indexed previousSigner, address indexed newSigner, address indexed updatedBy);
    event FundsWithdrawn(address indexed recipient, uint256 amountWei, address indexed withdrawnBy);

    error EmptyRegistrationReference();
    error DuplicateRegistrationPayment(string registrationReference);
    error FeeNotConfigured();
    error InvalidPaymentAmount(uint256 expectedWei, uint256 sentWei);
    error QuoteExpired(uint64 expiresAt, uint256 currentTimestamp);
    error QuoteAlreadyUsed(bytes32 quoteId);
    error QuoteSignerNotSet();
    error InvalidQuoteSignature();
    error ZeroAddressNotAllowed();
    error ZeroWithdrawalAmount();
    error InsufficientContractBalance(uint256 requestedWei, uint256 availableWei);
    error WithdrawalTransferFailed();
    error DirectEthTransferNotAllowed();

    constructor(address admin, address initialQuoteSigner, uint256 initialConfigurableFeeWei) {
        if (admin == address(0)) revert ZeroAddressNotAllowed();

        _grantRole(DEFAULT_ADMIN_ROLE, admin);
        _grantRole(FEE_ADMIN_ROLE, admin);
        _grantRole(TREASURY_ROLE, admin);
        _grantRole(PAUSER_ROLE, admin);

        quoteSigner = initialQuoteSigner;
        configurableFeeWei = initialConfigurableFeeWei;

        emit QuoteSignerUpdated(address(0), initialQuoteSigner, admin);
        emit ConfigurableFeeUpdated(0, initialConfigurableFeeWei, admin);
    }

    /**
     * @notice Pay a registration fee using an off-chain backend-signed NGN->ETH expiring quote.
     * @param registrationReference Unique application reference (e.g. "ANG-APP-2026-0009").
     * @param quoteId Unique 32-byte quote identifier generated by the backend.
     * @param requiredAmountWei Exact native ETH amount in wei computed from NGN fee & exchange rate.
     * @param expiresAt Unix timestamp after which the quote expires.
     * @param signature EIP-191 signature from `quoteSigner`.
     */
    function payWithQuote(
        string calldata registrationReference,
        bytes32 quoteId,
        uint256 requiredAmountWei,
        uint64 expiresAt,
        bytes calldata signature
    ) external payable whenNotPaused nonReentrant {
        if (bytes(registrationReference).length == 0) revert EmptyRegistrationReference();
        if (quoteSigner == address(0)) revert QuoteSignerNotSet();
        if (requiredAmountWei == 0) revert FeeNotConfigured();
        if (block.timestamp > expiresAt) revert QuoteExpired(expiresAt, block.timestamp);
        if (usedQuoteIds[quoteId]) revert QuoteAlreadyUsed(quoteId);

        bytes32 regRefHash = keccak256(bytes(registrationReference));
        if (_paymentsByRefHash[regRefHash].paid) {
            revert DuplicateRegistrationPayment(registrationReference);
        }

        bytes32 digest = keccak256(
            abi.encodePacked(
                block.chainid,
                address(this),
                regRefHash,
                quoteId,
                requiredAmountWei,
                expiresAt
            )
        ).toEthSignedMessageHash();

        address recovered = digest.recover(signature);
        if (recovered != quoteSigner) revert InvalidQuoteSignature();

        if (msg.value != requiredAmountWei) {
            revert InvalidPaymentAmount(requiredAmountWei, msg.value);
        }

        usedQuoteIds[quoteId] = true;
        _recordPayment(regRefHash, registrationReference, quoteId, msg.sender, msg.value);
    }

    /**
     * @notice Pay the registration fee configured on-chain for a registration reference or global configurable fee.
     * @param registrationReference Unique application reference (e.g. "ANG-APP-2026-0009").
     */
    function payRegistrationFee(string calldata registrationReference)
        external
        payable
        whenNotPaused
        nonReentrant
    {
        if (bytes(registrationReference).length == 0) revert EmptyRegistrationReference();

        bytes32 regRefHash = keccak256(bytes(registrationReference));
        if (_paymentsByRefHash[regRefHash].paid) {
            revert DuplicateRegistrationPayment(registrationReference);
        }

        uint256 expectedWei = quotedFeeWeiByRefHash[regRefHash];
        if (expectedWei == 0) {
            expectedWei = configurableFeeWei;
        }
        if (expectedWei == 0) revert FeeNotConfigured();
        if (msg.value != expectedWei) {
            revert InvalidPaymentAmount(expectedWei, msg.value);
        }

        _recordPayment(regRefHash, registrationReference, bytes32(0), msg.sender, msg.value);
    }

    function _recordPayment(
        bytes32 regRefHash,
        string calldata registrationReference,
        bytes32 quoteId,
        address payer,
        uint256 amountWei
    ) internal {
        _paymentsByRefHash[regRefHash] = PaymentRecord({
            registrationReference: registrationReference,
            quoteId: quoteId,
            payer: payer,
            amountWei: amountWei,
            paidAt: block.timestamp,
            paid: true
        });
        _paidRefHashes.push(regRefHash);

        emit PaymentReceived(
            regRefHash,
            registrationReference,
            quoteId,
            payer,
            amountWei,
            block.timestamp
        );
    }

    function setConfigurableFeeWei(uint256 newFeeWei) external onlyRole(FEE_ADMIN_ROLE) {
        uint256 prev = configurableFeeWei;
        configurableFeeWei = newFeeWei;
        emit ConfigurableFeeUpdated(prev, newFeeWei, msg.sender);
    }

    function setRegistrationQuoteFee(string calldata registrationReference, uint256 requiredAmountWei)
        external
        onlyRole(FEE_ADMIN_ROLE)
    {
        if (bytes(registrationReference).length == 0) revert EmptyRegistrationReference();
        bytes32 regRefHash = keccak256(bytes(registrationReference));
        quotedFeeWeiByRefHash[regRefHash] = requiredAmountWei;
        emit RegistrationFeeQuoted(regRefHash, registrationReference, requiredAmountWei, msg.sender);
    }

    function setQuoteSigner(address newQuoteSigner) external onlyRole(DEFAULT_ADMIN_ROLE) {
        address prev = quoteSigner;
        quoteSigner = newQuoteSigner;
        emit QuoteSignerUpdated(prev, newQuoteSigner, msg.sender);
    }

    function pause() external onlyRole(PAUSER_ROLE) {
        _pause();
    }

    function unpause() external onlyRole(PAUSER_ROLE) {
        _unpause();
    }

    function withdraw(address payable recipient, uint256 amountWei)
        external
        onlyRole(TREASURY_ROLE)
        nonReentrant
    {
        if (recipient == address(0)) revert ZeroAddressNotAllowed();
        if (amountWei == 0) revert ZeroWithdrawalAmount();
        uint256 balance = address(this).balance;
        if (amountWei > balance) revert InsufficientContractBalance(amountWei, balance);

        (bool ok, ) = recipient.call{value: amountWei}("");
        if (!ok) revert WithdrawalTransferFailed();

        emit FundsWithdrawn(recipient, amountWei, msg.sender);
    }

    function getPaymentByReference(string calldata registrationReference)
        external
        view
        returns (PaymentRecord memory)
    {
        return _paymentsByRefHash[keccak256(bytes(registrationReference))];
    }

    function hasPaid(string calldata registrationReference) external view returns (bool) {
        return _paymentsByRefHash[keccak256(bytes(registrationReference))].paid;
    }

    function totalPaymentsCount() external view returns (uint256) {
        return _paidRefHashes.length;
    }

    receive() external payable {
        revert DirectEthTransferNotAllowed();
    }

    fallback() external payable {
        revert DirectEthTransferNotAllowed();
    }
}
