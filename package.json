{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx backend/server.js",
    "dev:admin": "tsx backend/admin/src/server.js",
    "start": "tsx backend/server.js",
    "start:admin": "node backend/admin/src/server.js",
    "build": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "evaluate": "tsx backend/src/scripts/runEvaluation.js",
    "lint": "tsc --noEmit",
    "contracts:compile": "hardhat compile --config contracts/hardhat.config.cjs",
    "contracts:test": "hardhat test --config contracts/hardhat.config.cjs",
    "deploy:amoy:token": "hardhat run contracts/scripts/deployToken.cjs --network polygonAmoy --config contracts/hardhat.config.cjs",
    "deploy:amoy:title": "hardhat run contracts/scripts/deploy.cjs --network polygonAmoy --config contracts/hardhat.config.cjs",
    "deploy:amoy:escrow": "hardhat run contracts/scripts/deployEscrow.cjs --network polygonAmoy --config contracts/hardhat.config.cjs",
    "deploy:sepolia:payment": "hardhat run contracts/scripts/deployPayment.cjs --network sepolia --config contracts/hardhat.config.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.1.1",
    "aedes": "^1.2.0",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "leaflet-control-geocoder": "^4.0.0",
    "leaflet-draw": "1.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mqtt": "^5.16.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomicfoundation/ignition-core": "^0.15.0",
    "@openzeppelin/contracts": "^5.1.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "chai": "^4.2.0",
    "esbuild": "^0.25.0",
    "hardhat": "^2.22.19",
    "hardhat-gas-reporter": "^1.0.8",
    "solc": "^0.8.24",
    "solidity-coverage": "^0.8.1",
    "tailwindcss": "^4.3.3",
